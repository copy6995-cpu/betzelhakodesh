# PostgreSQL connection (Dokploy will inject the real value in production)
DATABASE_URL="postgresql://betzel:betzel@localhost:5432/betzel?schema=public"

# NextAuth
# Generate: `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# First admin user (seed-admin.ts creates this on first boot)
ADMIN_EMAIL="admin@betzelhakodesh.com"
ADMIN_PASSWORD="change-me-in-production"
ADMIN_NAME="אדמין"

# Path to the "בצילא תשפו.xlsx" file for seed-bachurim.ts (only used first boot)
# In production, upload the file into the container under /app/import/ before first run
IMPORT_XLSX="./prisma/seed-data.xlsx"

# Current active school year (e.g., "תשפ\"ו", "תשפ\"ז")
ACTIVE_YEAR="תשפ\"ו"

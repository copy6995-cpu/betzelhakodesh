# SQLite database file — relative to the app root.
DATABASE_URL="file:./betzel.db"

# NextAuth. Any long random string works locally.
NEXTAUTH_SECRET="change-me-locally-any-long-random-string-works"
NEXTAUTH_URL="http://localhost:3000"

# First admin user (seed-admin.ts upserts on every boot).
ADMIN_EMAIL="8562139@gmail.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="אדמין"

# Current active school year.
ACTIVE_YEAR="תשפ\"ו"

# ============================================================
# API integrations (optional — can also be set from the UI at
# /settings/nedarim and /settings/yemot). Values here override
# the UI settings.
# ============================================================

# --- Nedarim Plus ---
# מזהה מוסד (7 ספרות)
NEDARIM_MOSAD_ID=""
# סיסמת API להיסטוריית עסקאות
NEDARIM_API_PASSWORD=""
# סיסמת API לטפסים (אם שונה מהעסקאות — נדרים פלוס מנפיק סיסמה נפרדת)
NEDARIM_FORMS_PASSWORD=""

# --- Yemot HaMashiach (ימות המשיח) ---
# הטוקן המלא מפאנל ימות: הגדרות מערכת → הרשאות → API.
# שלושה חלקים מופרדים בנקודות, למשל: WU1BUElL.apik_XXXX.YYYY
# (הפורמט הישן מספר-מערכת:סיסמה לא נתמך)
YEMOT_TOKEN=""

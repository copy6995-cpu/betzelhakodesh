generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  // "admin" = full access + can manage users. "user" = limited to `sections`.
  role         String   @default("admin")
  // JSON array of section keys a non-admin user may access (see lib/sections).
  // Ignored for admins. Example: ["bachurim","payments","calendar"].
  sections     String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Parent {
  id          String    @id @default(cuid())
  tz          String?   @unique
  // Father's mobile ("פלאפון" in the roster xlsx). Primary contact number.
  phone       String?
  // Landline / home phone ("טלפון" in the roster xlsx).
  homePhone   String?
  // Mother's mobile ("פלאפון אם").
  motherPhone String?
  email       String?
  firstName   String
  lastName    String
  city        String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  students    Student[]

  @@index([lastName, firstName])
  @@index([phone])
}

model Student {
  id              String   @id @default(cuid())
  year            String
  personalCode    String

  parentId        String
  parent          Parent   @relation(fields: [parentId], references: [id], onDelete: Restrict)

  firstName       String
  lastName        String
  fatherName      String
  city            String?
  yeshiva         String
  shiur           String?
  ariChul         String?

  price           Int?
  paymentMethod   String?
  paymentsCount   Int?
  nedarimHook     String?
  endDateLabel    String?
  endDate         DateTime?
  registeredEshel Boolean  @default(false)
  // "תוקף" column in the תשפ"ז roster — community/branch affiliation
  // (e.g. "בית מרדכי", "מונסי", "לונדון", "1"). Optional; may repeat.
  branch          String?
  // Yeshiva-side numeric code from "קוד ישיבה" in the roster xlsx.
  yeshivaCode     String?
  notes           String?
  archived        Boolean  @default(false)

  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([year, personalCode])
  @@index([year, yeshiva])
  @@index([parentId])
  @@index([year, shiur])
  @@index([year, lastName, firstName])
}

model Payment {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentNumber Int
  // SQLite has no native Decimal; Float is fine for ILS amounts under 1M.
  // If precision ever matters, switch to String.
  amount        Float
  method        String?
  date          DateTime?
  externalRef   String?
  notes         String?
  // How this Payment got here — determines what a "purge legacy" run
  // touches. "legacy" = imported from the original xlsx once. "nedarim"
  // = materialized from a NedarimTransaction. "manual" = created by the
  // office via the + תשלום חדש button. Only "legacy" is safe to bulk-delete.
  source        String   @default("manual")
  createdAt     DateTime @default(now())

  @@index([studentId])
  @@index([externalRef])
  @@index([source])
}

model AppSetting {
  key   String @id
  value String
}

model Yeshiva {
  id           String  @id @default(cuid())
  name         String  @unique
  displayOrder Int     @default(0)
  active       Boolean @default(true)
}

model Shiur {
  id           String @id @default(cuid())
  name         String @unique
  displayOrder Int    @default(0)
}

model EndDateOption {
  id    String    @id @default(cuid())
  year  String
  label String
  date  DateTime?

  @@unique([year, label])
}

/// Transaction pulled from Nedarim Plus (GetHistoryJson). We store enough
/// to reconcile against Student.nedarimHook (via kevaId) or by phone/tz to
/// the parent. Fields mirror the API response 1:1 so we can grow without
/// migrations. Extra fields land in `raw` as JSON string.
model NedarimTransaction {
  id              String    @id @default(cuid())
  transactionId   String    @unique // TransactionId from Nedarim (deduped)
  shovar          String?
  zeout           String?
  clientName      String?
  adresse         String?
  phone           String?
  mail            String?
  amount          Float?
  currency        Int?      // 1=ILS, 2=USD
  transactionTime DateTime?
  confirmation    String?
  lastNum         String?
  transactionType String?
  groupe          String?
  comments        String?
  tashloumim      Int?
  firstTashloum   Float?
  nextTashloum    Float?
  kabalaId        String?
  kevaId          String?   // links to Student.nedarimHook for HK transactions
  callId          String?
  masofId         String?
  raw             String    // full JSON payload for anything we didn't map
  fetchedAt       DateTime  @default(now())

  @@index([kevaId])
  @@index([phone])
  @@index([zeout])
  @@index([transactionTime])
}

/// A single Nedarim form submission (GetJson). Shape is variable per TofesId,
/// so the values are stored as a JSON blob. rowId is what identifies the
/// submission in Nedarim.
model NedarimFormSubmission {
  id         String   @id @default(cuid())
  tofesId    String   // which form this belongs to
  rowId      String   // ID from Nedarim
  submittedAt DateTime?
  raw        String   // full JSON payload
  fetchedAt  DateTime @default(now())

  @@unique([tofesId, rowId])
  @@index([tofesId, submittedAt])
}

/// Meta about which forms exist. User configures TofesId + display label.
model NedarimFormConfig {
  id        String   @id @default(cuid())
  tofesId   String   @unique
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

/// A single הוראת קבע (standing order) pulled from Nedarim Plus'
/// `GetKevaNew` endpoint. Represents the current commitment: monthly
/// amount, how many charges are left, next charge date, error state.
/// Distinct from `NedarimTransaction` which is the history of actually-
/// executed charges — this table is the FORWARD-looking view (what will
/// still be charged).
model NedarimKeva {
  id             String    @id @default(cuid())
  kevaId         String    @unique         // DT_RowId in the API response
  clientName     String?
  addressPhone   String?                    // "כתובת מלאה וטלפון" — API returns combined
  amount         Float?                     // סכום לחיוב
  currency       Int?                       // 1 = ILS, 2 = USD (derived from Amount)
  category       String?                    // קטגוריה
  comments       String?
  itra           Int?                       // יתרת חיובים (# of remaining charges)
  success        Int?                       // מספר חיובים שבוצעו
  nextDate       String?                    // תאריך חיוב הבא — dd/mm/yyyy from the API
  errorText      String?                    // שגיאה בעת נסיון חיוב
  lastNum        String?                    // 4 ספרות אחרונות של הכרטיס
  tokef          String?                    // תוקף mmYY
  hasToremCard   Boolean   @default(false)  // 14: יש כרטיס תורם
  raw            String                     // full JSON row for anything we didn't map
  fetchedAt      DateTime  @default(now())

  @@index([kevaId])
}

/// A single row from a Yemot HaMashiach ApprovalAll.YYYY-WW.ymgr file.
/// The API returns Hebrew-keyed fields; we normalize them into columns.
/// personalCode is what links this to Student.personalCode.
model YemotBedReservation {
  id           String   @id @default(cuid())
  source       String   // e.g. "ivr2:דוחות/1"
  weekKey      String   // YYYY-WW (2025-32)
  personalCode String   // "מספר זיהוי" from the ymgr row
  name         String?  // "שם מזהה"
  status       String?  // "מצב הזמנה" — usually "מאושר" or "אזל"
  date         String?  // "תאריך" — dd/mm/yyyy (from Yemot)
  className    String?  // "גזירה חמישית" (repurposed as class/branch label in this org)
  branch       String?  // "גזירה שישית"
  hebDate      String?  // "תאריך עברי"
  raw          String   // full row JSON
  fetchedAt    DateTime @default(now())

  @@unique([source, weekKey, personalCode])
  @@index([weekKey])
  @@index([personalCode])
  @@index([status])
}

/// Credit card charges made via the Yemot phone system (LogCreditCardOK.ymgr).
/// Each row = one approved credit card transaction. The "מספר אישור" field is
/// the Nedarim Plus hook/keva number.
model YemotCreditCard {
  id             String   @id @default(cuid())
  personalCode   String
  phone          String?
  amount         Float?
  currency       Int?
  installments   Int?
  status         String?
  approvalNum    String?
  date           String?
  hebDate        String?
  year           String?
  lastDigits     String?
  chargeDay      String?
  nextChargeDate String?
  customerName   String?
  raw            String?
  fetchedAt      DateTime @default(now())

  @@unique([approvalNum])
}

/// Which Yemot IVR paths to sync from. `current: true` = included in "update
/// latest week" (skip archive folders). Order controls sync/display.
model YemotSource {
  id      String  @id @default(cuid())
  path    String  @unique // "ivr2:דוחות/1"
  current Boolean @default(true)
  order   Int     @default(0)
  label   String?
  // "booking" (default) or "cancellation" — a cancellation source (שלוחה 5
  // from the main menu) lists students who cancelled; a matching
  // personalCode+weekKey voids that week's booking everywhere in reports.
  kind    String  @default("booking")
}

/// A single physical room in the building. Grouped by `building` (which
/// mirrors the sheet name in the original Excel drawing — קומה 1 חדרים
/// 100-109 / דרעזיל / etc). `active=false` retires a room without deleting
/// the historical allocations that reference it.
model Room {
  id          String  @id @default(cuid())
  code        String  @unique          // "א100"
  building    String                    // "קומה 1 חדרים 100-109"
  displayName String?                   // optional prettier label
  capacity    Int?                      // beds count, if known
  order       Int     @default(0)
  active      Boolean @default(true)

  allocations RoomAllocation[]

  @@index([building])
}

/// Week-scoped room-to-yeshiva assignment. `weekKey` is the Sunday date of
/// the week in YYYY-MM-DD format (e.g. 2026-07-13 for the week starting
/// Sunday 13-Jul-2026). Every week gets fresh allocations; past weeks stay
/// in the DB as history. Import from an Excel spreadsheet is supported via
/// the UI so old years can be back-filled.
model RoomAllocation {
  id        String   @id @default(cuid())
  weekKey   String                     // "2026-07-13"  (Sunday date, ISO)
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  yeshiva   String                     // yeshiva name (matches Yeshiva.name)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekKey, roomId])
  @@index([weekKey])
  @@index([weekKey, yeshiva])
  @@index([yeshiva])
}

/// Per-"year" config for the calendar page (/calendar). Keyed by the school-
/// year label. The academic year runs by Hebrew date, so the office sets an
/// arbitrary Gregorian start→end range (default 22 Av → 22 Av next year).
/// `supervisorNames` is a JSON array of up to 9 header names.
model CalendarConfig {
  id              String   @id @default(cuid())
  yearLabel       String   @unique
  startDate       DateTime
  endDate         DateTime
  supervisorNames String   @default("[]")
  updatedAt       DateTime @updatedAt
}

/// Editable cell values for one Shabbat row of the calendar. `weekKey` is the
/// Shabbat's ISO date (YYYY-MM-DD). `values` is a JSON blob:
///   { yeshivot: string[5], linaChul, linaAri, sup: {lina,kima}[9] }
/// The auto columns (Hebrew date, parasha, special-Shabbat note) are computed
/// from @hebcal, never stored.
model CalendarWeek {
  id        String   @id @default(cuid())
  yearLabel String
  weekKey   String
  values    String   @default("{}")
  updatedAt DateTime @updatedAt

  @@unique([yearLabel, weekKey])
  @@index([yearLabel])
}

/// Manual cash-book rows for the income/expenses page. Auto-computed figures
/// (Nedarim, group credit, supervisor cost from the calendar) are NOT stored
/// here — only the hand-entered rows.
model FinanceEntry {
  id        String    @id @default(cuid())
  year      String
  kind      String // "income" | "expense"
  /// income: "other" | "check" | "transfer"; expense: "misc" |
  /// "supervisor-payment" | "beit-malka" | "rent" | ...
  category  String
  label     String? // description / supervisor name / project name
  amount    Float     @default(0)
  date      DateTime?
  meta      String? // JSON extras (e.g. beit-malka bed count, supervisor id)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([year, kind])
}
